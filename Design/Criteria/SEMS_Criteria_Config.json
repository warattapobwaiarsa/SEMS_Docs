  "criteria_set": {
    "criteria_set_code": "SEMS-DEFAULT-100",
    "criteria_set_name": "เกณฑ์ประเมินทุนการศึกษา คะแนนเต็ม 100",
    "criteria_version": "1.0.0",
    "scholarship_round_id": "TBD_BY_ADMIN",
    "score_mode": "EMBEDDED_POINT",
    "total_min_score": 5,
    "total_max_score": 100,
    "weight_total_percent": 100,
    "criteria_count": 10,
    "is_active": false
  },
  "calculation_rules": {
    "evaluator_total_formula": "SUM(item_score for all 10 required scored criteria)",
    "weight_interpretation": "คะแนนของแต่ละตัวเลือกเป็นคะแนนถ่วงน้ำหนักสำเร็จแล้ว; weight_percent ใช้เป็น metadata และไม่คูณซ้ำ",
    "eligible_evaluation_status": [
      "SUBMITTED"
    ],
    "minimum_submitted_evaluators": 2,
    "maximum_evaluators": 3,
    "unique_evaluator_required": true,
    "applicant_summary_formula": "ARITHMETIC_MEAN(evaluator_total of eligible unique evaluators)",
    "recalculate_on_third_submission": true,
    "rounding": {
      "scale": 2,
      "mode": "HALF_UP",
      "stage": "FINAL_APPLICANT_SUMMARY_ONLY",
      "use_decimal_not_binary_float": true
    },
    "summary_available_when": "submitted_evaluator_count >= 2",
    "finalized_when": "scholarship_round.status == CLOSED and submitted_evaluator_count >= 2"
  },
  "comment_rules": {
    "overall_comment_required": false,
    "conditional_comment_required": [
      "CRT-04 option USE-OTHER-NECESSARY",
      "CRT-09 option JUDGMENT-URGENT",
      "CRT-09 option JUDGMENT-OTHER",
      "CRT-09 option JUDGMENT-CUSTOM"
    ],
    "minimum_comment_length_when_required": 10
  },
  "versioning_rules": {
    "lock_trigger": "เมื่อมี Evaluation ที่ยังไม่ถูกยกเลิกอย่างน้อย 1 รายการ ไม่ว่าจะเป็น DRAFT หรือ SUBMITTED",
    "direct_edit_after_lock": false,
    "change_method": "สร้าง Criteria Version ใหม่",
    "evaluation_stores_criteria_version_snapshot": true,
    "current_round_switch_after_lock": "ห้ามสลับเวอร์ชันในรอบเดิมโดยตรง; ต้องยกเลิกรายการประเมินทั้งหมดและดำเนินการตามกระบวนการอนุมัติเท่านั้น"
  },
